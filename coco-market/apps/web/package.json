{
  "name": "@coco/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "VITE_API_MODE=server vite",
    "build": "tsc --noEmit -p . && vite build",
    "build:demo": "VITE_API_MODE=demo vite build --outDir dist-demo",
    "typecheck": "tsc --noEmit -p .",
    "test": "echo 'web: covered by e2e (pnpm --filter @coco/e2e test)'"
  },
  "dependencies": {
    "@coco/core": "workspace:*",
    "pretendard": "1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
