{
  "name": "coco-market",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint:compliance": "node scripts/compliance-lint.mjs",
    "guard:red": "node scripts/guard-red.mjs",
    "check": "pnpm typecheck && pnpm lint:compliance && pnpm guard:red && pnpm test",
    "dev:api": "pnpm --filter @coco/api dev",
    "dev:web": "pnpm --filter @coco/web dev"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
